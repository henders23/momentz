{
  "name": "momentz",
  "version": "1.0.0",
  "private": true,
  "description": "Momentz: an AI study coach that turns one moment from your week into one small thing to try.",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
